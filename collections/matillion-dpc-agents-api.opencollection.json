            "url": "https://eu1.api.matillion.com/dpc/v1/agents",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://id.core.matillion.com/oauth/dpc/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Register a Data Productivity Cloud Agent."
        },
        {
