              "accessTokenUrl": "https://id.core.matillion.com/oauth/dpc/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get a Data Productivity Cloud Agent."
        },
